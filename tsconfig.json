{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "services/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
