{
  "name": "kil-business",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KIL Business ERP monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop": "vitest run desktop",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "eslint": "^10.15.0",
    "jsdom": "^25.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
