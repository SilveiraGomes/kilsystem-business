{
  "name": "kil-business",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KIL Business ERP monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.16.0 <23",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": ">=9.15.0 <10",
    "@types/node": "^22.10.2",
    "eslint": ">=9.15.0 <10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
