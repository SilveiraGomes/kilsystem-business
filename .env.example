# Ambiente local; copie para .env e nunca versione segredos.
NODE_ENV=development

# API local
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=4100
# Caminho absoluto fora do repositório e dos artefactos de build, com extensão .sqlite, .sqlite3 ou .db
# (validado por resolveDatabaseLocation). Sem valor por omissão: a localização definitiva depende da
# estratégia de instalação e de cópias de segurança.
LOCAL_DATABASE_PATH=

# Serviço local de dados (E1.05). As variáveis são lidas de process.env; este ficheiro NÃO é carregado
# automaticamente. Ambiente: development | test | production.
LOCAL_SERVICE_ENVIRONMENT=
# Identificador da instância nos registos: 1 a 64 caracteres [A-Za-z0-9._-].
LOCAL_SERVICE_INSTANCE_ID=
# debug | info | warn | error (opcional; por omissão: info).
LOCAL_SERVICE_LOG_LEVEL=info
# Base inexistente: create | fail.
LOCAL_SERVICE_ON_MISSING_DATABASE=
# Migrações pendentes: apply | fail.
LOCAL_SERVICE_ON_PENDING_MIGRATIONS=

# Serviços centrais (valores de desenvolvimento, sem credenciais reais)
CENTRAL_API_HOST=127.0.0.1
CENTRAL_API_PORT=4200
CENTRAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Sincronização
SYNC_INTERVAL_SECONDS=60

# Licenciamento: integração independente; URL e contrato ainda não definidos.
KIL_LICENSE_SERVER_URL=
KIL_LICENSE_CLIENT_ID=
KIL_LICENSE_CLIENT_SECRET=
